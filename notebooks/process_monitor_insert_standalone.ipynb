   "source": [
    "import psycopg2\n",
    "import logging\n",
    "from datetime import datetime\n",
    "import json\n",
    "import uuid\n",
    "\n",
    "def insert_process_monitor_log(\n",
    "    run_uuid: str,\n",
    "    model_name: str,\n",
    "    stage_name: str,\n",
    "    stage_start_time: str,\n",
    "    stage_end_time: str = None,\n",
    "    duration_ms: int = None,\n",
    "    llm_calls: list = None,\n",
    "    total_tokens: int = None,\n",
    "    total_cost: float = None,\n",
    "    status: str = None,\n",
    "    decision_details: str = None,\n",
    "    error_message: str = None,\n",
    "    user_id: str = None,\n",
    "    environment: str = None,\n",
    "    custom_metadata: dict = None,\n",
    "    notes: str = None\n",
    "):\n",
    "    \"\"\"\n",
    "    Insert a new record into the process_monitor_logs table.\n",
    "    \"\"\"\n",
    "    # Hardcoded DB config - replace with config loading as needed\n",
    "    db_config = {\n",
    "        'host': 'localhost',\n",
    "        'port': 5432,\n",
    "        'dbname': 'your_database',\n",
    "        'user': 'your_user',\n",
    "        'password': 'your_password'\n",
    "    }\n",
    "\n",
    "    # Setup logger\n",
    "    logger = logging.getLogger('process_monitor_logger')\n",
    "    if not logger.hasHandlers():\n",
    "        logging.basicConfig(level=logging.INFO)\n",
    "\n",
    "    # Validate required fields\n",
    "    required_fields = {\n",
    "        'run_uuid': run_uuid,\n",
    "        'model_name': model_name,\n",
    "        'stage_name': stage_name,\n",
    "        'stage_start_time': stage_start_time\n",
    "    }\n",
    "    missing_fields = [k for k, v in required_fields.items() if v is None]\n",
    "    if missing_fields:\n",
    "        raise ValueError(f\"Missing required fields: {', '.join(missing_fields)}\")\n",
    "\n",
    "    # Validate types and lengths\n",
    "    try:\n",
    "        # Validate UUID\n",
    "        uuid_obj = uuid.UUID(run_uuid)\n",
    "        # Validate timestamps\n",
    "        stage_start_dt = datetime.fromisoformat(stage_start_time)\n",
    "        stage_end_dt = datetime.fromisoformat(stage_end_time) if stage_end_time else None\n",
    "        # Validate string lengths\n",
    "        if len(model_name) > 100:\n",
    "            raise ValueError('model_name exceeds max length 100')\n",
    "        if len(stage_name) > 100:\n",
    "            raise ValueError('stage_name exceeds max length 100')\n",
    "        if status and len(status) > 255:\n",
    "            raise ValueError('status exceeds max length 255')\n",
    "        if environment and len(environment) > 50:\n",
    "            raise ValueError('environment exceeds max length 50')\n",
    "        if user_id and len(user_id) > 255:\n",
    "            raise ValueError('user_id exceeds max length 255')\n",
    "        # Validate JSON fields\n",
    "        llm_calls_json = json.dumps(llm_calls) if llm_calls is not None else None\n",
    "        custom_metadata_json = json.dumps(custom_metadata) if custom_metadata is not None else None\n",
    "    except Exception as e:\n",
    "        raise ValueError(f\"Validation error: {e}\")\n",
    "\n",
    "    # Connect to DB and insert\n",
    "    try:\n",
    "        conn = psycopg2.connect(**db_config)\n",
    "        cur = conn.cursor()\n",
    "        insert_query = '''\n",
    "        INSERT INTO process_monitor_logs (\n",
    "            run_uuid, model_name, stage_name, stage_start_time, stage_end_time, duration_ms,\n",
    "            llm_calls, total_tokens, total_cost, status, decision_details, error_message,\n",
    "            user_id, environment, custom_metadata, notes\n",
    "        ) VALUES (\n",
    "            %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s\n",
    "        )\n",
    "        RETURNING log_id;\n",
    "        '''\n",
    "        cur.execute(insert_query, (\n",
    "            run_uuid, model_name, stage_name, stage_start_dt, stage_end_dt, duration_ms,\n",
    "            llm_calls_json, total_tokens, total_cost, status, decision_details, error_message,\n",
    "            user_id, environment, custom_metadata_json, notes\n",
    "        ))\n",
    "        inserted_log_id = cur.fetchone()[0]\n",
    "        conn.commit()\n",
    "\n",
    "        # Verify insertion\n",
    "        cur.execute('SELECT log_id FROM process_monitor_logs WHERE log_id = %s', (inserted_log_id,))\n",
    "        result = cur.fetchone()\n",
    "        if result:\n",
    "            logger.info(f\"Record inserted successfully with log_id: {inserted_log_id}\")\n",
    "        else:\n",
    "            logger.error(\"Record insertion verification failed.\")\n",
    "        cur.close()\n",
    "        conn.close()\n",
    "    except Exception as e:\n",
    "        logger.error(f\"Database error: {e}\")\n",
    "        raise\n"
   ]
  },
