# Environment Variables Template for IRIS Project
# Copy this file to .env and fill in your actual values

# ===========================================
# REQUIRED VARIABLES (must be set)
# ===========================================

# Database Configuration
VECTOR_POSTGRES_DB_HOST=your_db_host_here
VECTOR_POSTGRES_DB_USERNAME=your_db_username_here
VECTOR_POSTGRES_DB_PASSWORD=your_db_password_here
VECTOR_POSTGRES_DB_PORT=5432
VECTOR_POSTGRES_DB_NAME=finance-dev

# OAuth Configuration
OAUTH_URL=your_oauth_url_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# S3 Configuration
S3_BASE_PATH=your_s3_base_url_here

# ===========================================
# OPTIONAL VARIABLES (have defaults)
# ===========================================

# API Configuration
AZURE_BASE_URL=https://perf-apigw-int.saifg.rbc.com/JLCO/llm-control-stack/v1

# Request Configuration
REQUEST_TIMEOUT=180
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2

# SSL Configuration
IRIS_SSL_CERT_FILENAME=rbc-ca-bundle.cer
IRIS_SSL_CHECK_CERT_EXPIRY=true
IRIS_SSL_EXPIRY_WARNING_DAYS=30

# Model Configuration
IRIS_MODEL_SMALL=gpt-4o-mini-2024-07-18
IRIS_MODEL_LARGE=gpt-4o-2024-05-13
IRIS_MODEL_EMBEDDING=text-embedding-3-large

# Model Costs (per token)
IRIS_MODEL_SMALL_PROMPT_COST=0.00016238
IRIS_MODEL_SMALL_COMPLETION_COST=0.00065175
IRIS_MODEL_LARGE_PROMPT_COST=0.00064952
IRIS_MODEL_LARGE_COMPLETION_COST=0.00260748
IRIS_MODEL_EMBEDDING_PROMPT_COST=0.0001
IRIS_MODEL_EMBEDDING_COMPLETION_COST=0.0001

# Logging Configuration
IRIS_LOG_LEVEL=DEBUG
IRIS_TOKEN_PREVIEW_LENGTH=7
IRIS_SHOW_USAGE_SUMMARY=true

# Conversation Configuration
IRIS_MAX_HISTORY_LENGTH=10
IRIS_INCLUDE_SYSTEM_MESSAGES=false

# Process Monitoring
IRIS_PROCESS_MONITOR_MODEL_NAME=iris

# ===========================================
# IT-SPECIFIC VARIABLES (for IT infrastructure)
# ===========================================
# These variables are used by IT's modified src code.
# For local development, you can leave these empty - the compatibility
# layer will provide safe defaults.

# Application Identifier (for IT's reporting system)
IRIS_APP_ID=iris

# Authentication Service (leave empty for local dev - auth will be skipped)
TOKEN_VALIDATION_URL=

# PII Detection Service (leave empty for local dev - PII detection will be skipped)
PII_SERVICE_URL=

# PII Excludes (comma-separated list of terms to exclude from PII detection)
PII_EXCLUDES=

# AD Group to Database Mapping (leave empty for local dev - all databases accessible)
# Format: group1:db1,db2,db3;group2:db4,db5
AD_GROUP_MAPPING=